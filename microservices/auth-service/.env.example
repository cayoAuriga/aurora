# Auth Service Configuration
AUTH_SERVICE_NAME=auth-service
AUTH_SERVICE_PORT=8005
AUTH_ENVIRONMENT=development
AUTH_DEBUG=true
AUTH_LOG_LEVEL=INFO
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
AUTH_HOST=127.0.0.1

# Database Configuration (TiDB)
AUTH_DATABASE_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
AUTH_DATABASE_PORT=4000
AUTH_DATABASE_NAME=aurora_auth
AUTH_DATABASE_USER=your_user
AUTH_DATABASE_PASSWORD=your_password
AUTH_DATABASE_SSL_CA=/path/to/ca.pem

# JWT Configuration
AUTH_SECRET_KEY=your-secret-key-change-this-in-production
AUTH_REFRESH_SECRET_KEY=your-refresh-secret-key-change-this
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (for token blacklist and rate limiting)
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0

# Email Configuration (optional)
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=your-email@gmail.com
AUTH_SMTP_PASSWORD=your-app-password
AUTH_EMAILS_FROM_EMAIL=noreply@aurora.dev
AUTH_EMAILS_FROM_NAME=Aurora Platform